{
  "manifest_version": 3,
  "name": "Kazi Timer",
  "description": "Track intentional work and save it to Kazi.",
  "version": "0.5.8",
  "action": {
    "default_title": "Kazi Timer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/kazi.png",
      "32": "icons/kazi.png",
      "48": "icons/kazi.png",
      "128": "icons/kazi.png"
    }
  },
  "icons": {
    "16": "icons/kazi.png",
    "32": "icons/kazi.png",
    "48": "icons/kazi.png",
    "128": "icons/kazi.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "update_url": "https://kazi.growthpad.africa/extensions/kazi-timer/updates.xml",
  "permissions": [
    "alarms",
    "storage",
    "identity",
    "scripting",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "https://kazi.growthpad.africa/*",
    "https://app.asana.com/*",
    "https://mail.google.com/*",
    "https://github.com/*",
    "https://app.slack.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "content_scripts": [
    {
      "matches": ["https://app.asana.com/*"],
      "js": ["content/asana-task-timer.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content/gmail-timer.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://github.com/*"],
      "js": ["content/github-timer.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://app.slack.com/*"],
      "js": ["content/slack-timer.js"],
      "run_at": "document_idle"
    }
  ]
}
