{
  "manifest_version": 3,
  "name": "Kazi Timer",
  "description": "Track intentional work and save it to Kazi.",
  "version": "0.1.0",
  "action": {
    "default_title": "Kazi Timer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/kazi.png",
      "32": "icons/kazi.png",
      "48": "icons/kazi.png",
      "128": "icons/kazi.png"
    }
  },
  "icons": {
    "16": "icons/kazi.png",
    "32": "icons/kazi.png",
    "48": "icons/kazi.png",
    "128": "icons/kazi.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://kazi.growthpad.africa/*"],
      "js": ["content/kazi-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["alarms", "storage", "identity"],
  "host_permissions": ["https://kazi.growthpad.africa/*"]
}
