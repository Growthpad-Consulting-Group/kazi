{
  "manifest_version": 3,
  "name": "Kazi Timer",
  "description": "Track intentional work and save it to Kazi.",
  "version": "0.3.8",
  "action": {
    "default_title": "Kazi Timer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/kazi.png",
      "32": "icons/kazi.png",
      "48": "icons/kazi.png",
      "128": "icons/kazi.png"
    }
  },
  "icons": {
    "16": "icons/kazi.png",
    "32": "icons/kazi.png",
    "48": "icons/kazi.png",
    "128": "icons/kazi.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "update_url": "https://kazi.growthpad.africa/extensions/kazi-timer/updates.xml",
  "permissions": ["alarms", "storage", "identity", "scripting", "activeTab"],
  "host_permissions": ["https://kazi.growthpad.africa/*"],
  "optional_host_permissions": ["https://*/*"]
}
