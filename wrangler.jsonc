{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kazi",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXTAUTH_URL": "https://kazi.growthpad.co.ke"
  }
}
